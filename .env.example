# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-placeholder

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/healthcare_db?sslmode=prefer"

# Client Configuration
VITE_API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Gemini LLM Service Configuration
GEMINI_API_KEY=your-gemini-api-key-placeholder
SIMULATE_LLM_FAILURE=false
